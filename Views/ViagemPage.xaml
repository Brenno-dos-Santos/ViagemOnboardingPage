<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ViagemOnboardingPage.Views.ViagemPage"
             xmlns:viewmodel="clr-namespace:ViagemOnboardingPage.ViewModels"
             xmlns:models="clr-namespace:ViagemOnboardingPage.Models"
             x:DataType="viewmodel:ViagemItemViewModel"
             Shell.NavBarIsVisible="False"
             Title="ViagemPage">

    <Grid RowDefinitions="*, Auto, Auto"
          Padding="0">

        <CarouselView Grid.Row="0"
                      Loop="False"
                      ItemsSource="{Binding Itens}"
                      IndicatorView="{x:Reference Indicator}"
                      Position="{Binding Position}"
                      >

            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="models:ViagemItem">

                    <VerticalStackLayout
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Padding="20"
                        Spacing="15">

                        <Image Source="{Binding UrlImage}"
                               HeightRequest="250"
                               Aspect="AspectFit" />

                        <Label Text="{Binding Title}"
                               FontSize="32"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="Black" />

                        <Label Text="{Binding Description}"
                               FontSize="16"
                               HorizontalTextAlignment="Center"
                               TextColor="Gray" />

                    </VerticalStackLayout>

                </DataTemplate>
            </CarouselView.ItemTemplate>

        </CarouselView>

        <IndicatorView x:Name="Indicator"
                       Grid.Row="1"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       IndicatorColor="#FFE3ED"
                       SelectedIndicatorColor="#FF1568"
                       IndicatorSize="14"
                       Margin="0,10,0,10" 
                       />

        <Grid Grid.Row="2"
              ColumnDefinitions="*,*"
              ColumnSpacing="15"
              Margin="20,0,20,20">

            <Button Grid.Column="0"
                    Text="Anterior"
                    Command="{Binding PreviousPositionCommand}"
                    BackgroundColor="#FF1568"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50" />

            <Button Grid.Column="1"
                    Text="Próximo"
                    Command="{Binding NextPositionCommand}"
                    IsVisible="{Binding ShowButton}"
                    BackgroundColor="#4EA717"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50" />

        </Grid>

    </Grid>

</ContentPage>
